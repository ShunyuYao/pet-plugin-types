{
  "name": "@pet/plugin-types",
  "version": "1.0.0-rc.4",
  "description": "桌宠（吐梨邦）插件 SDK 的 TypeScript 类型定义。SDK surface 的唯一权威文档，对应 apiVersion 1。",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "manifest.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShunyuYao/pet-plugin-types.git"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "petSdk": {
    "apiVersion": 1,
    "frozen": true,
    "frozenMethods": 30,
    "experimentalMethods": 24,
    "note": "与宿主 sdk-surface.js 的 30 条 frozen / 24 条 experimental 公开能力对齐；不暴露 closed 能力。"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "scripts": {
    "test:types": "tsc -p tsconfig.test.json",
    "test:host": "node test/check-host.js",
    "test": "npm run test:types",
    "test:delivery": "npm run test:types && npm run test:host"
  }
}
